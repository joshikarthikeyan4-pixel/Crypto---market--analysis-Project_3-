## Check nulls
SELECT
  SUM(CASE WHEN coin IS NULL THEN 1 ELSE 0 END) AS null_coin,
  SUM(CASE WHEN timestamp IS NULL THEN 1 ELSE 0 END) AS null_ts,
  SUM(CASE WHEN price_usd IS NULL THEN 1 ELSE 0 END) AS null_price
FROM crypto_prices;

## Row count (sanity check again)
SELECT COUNT(*) FROM crypto_prices;

